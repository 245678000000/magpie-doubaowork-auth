    "avatar.png",
    "README.md",
    "NOTICE.md",
    "LICENSE",
    "licenses",
    "test",
    "scripts/windows-browser-smoke.mjs",
    "scripts/doubao-browser-smoke.mjs",
    "scripts/isolated-browser-smoke.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "auth",
    "doubaowork",
    "doubao",
    "doubao-work",
    "browser-login",
    "doubao-browser",
    "multi-account"
  ],
  "license": "AGPL-3.0-only",
  "magpie": {
    "name": "豆包工作 · 独立版",
